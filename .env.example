###############################################################################
# Application
###############################################################################
APP_NAME=InfraCMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_VERSION=0.1.0-dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Comma-separated proxy IPs, or * when running behind a trusted load balancer.
TRUSTED_PROXIES=

###############################################################################
# Platform
###############################################################################
# Persistent installation identity, consumed by the licensing client.
PLATFORM_INSTALLATION_ID=

# Correlation identifiers. Only trust an inbound header when a proxy you
# control is guaranteed to set it.
CORRELATION_ID_HEADER=X-Correlation-Id
CORRELATION_ID_TRUST_INBOUND=false

# 0 keeps audit records forever, which is the correct default.
AUDIT_RETENTION_DAYS=0

ACCESS_CACHE_TTL=900

###############################################################################
# Logging
###############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Emit single-line JSON records. Enable in every deployed environment.
LOG_STRUCTURED=false

###############################################################################
# Database
###############################################################################
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=infracms
DB_USERNAME=infracms
DB_PASSWORD=secret
DB_TEST_DATABASE=infracms_test

###############################################################################
# Redis / cache / sessions / queues
###############################################################################
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

HORIZON_PREFIX=infracms_horizon:

BROADCAST_CONNECTION=log

###############################################################################
# Mail
###############################################################################
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@infracms.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Object storage (MinIO in development, S3-compatible in production)
###############################################################################
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=infracms
AWS_SECRET_ACCESS_KEY=infracms-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=infracms
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/infracms
AWS_USE_PATH_STYLE_ENDPOINT=true

###############################################################################
# Sanctum
###############################################################################
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173

###############################################################################
# Licensing control plane (Phase 11 — declared now for forward compatibility)
###############################################################################
# Security. `OUTBOUND_PORTS` is what an operator-supplied URL may connect to —
# kept short on purpose, because a webhook endpoint on port 6379 is somebody
# asking this platform to talk to their Redis. `REAUTH_MINUTES` is how long a
# confirmed password counts for before an irreversible action asks again.
OUTBOUND_PORTS=80,443,8080,8443
REAUTH_MINUTES=15
CSP_REPORT_URI=

# The Laravel database connection holding a legacy system to import from.
# Read-only: the importer issues nothing but `select`.
IMPORT_WHMCS_CONNECTION=legacy

LICENSE_API_URL=
LICENSE_KEY=
LICENSE_PUBLIC_KEY_PATH=
# How long the last good answer keeps working when the licence server cannot
# be reached, counted from the heartbeat deadline the vendor set.
LICENSE_GRACE_DAYS=30

###############################################################################
# Front end
###############################################################################
VITE_APP_NAME="${APP_NAME}"
VITE_HMR_HOST=localhost
