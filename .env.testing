###############################################################################
# Test environment.
#
# Loaded automatically because phpunit.xml sets APP_ENV=testing.
#
# Points at the forwarded ports of the development Compose stack so that the
# suite runs identically on a developer machine and in CI, where the MariaDB
# and Redis service containers are published on the same ports.
###############################################################################
APP_NAME=InfraCMS
APP_ENV=testing
APP_KEY=base64:Oaju9Wmx6H9lHwNXtC2bd19Hd6OhEO2IU0UQZYKXtlQ=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=33061
DB_DATABASE=infracms_test
DB_USERNAME=infracms
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=63791
REDIS_PASSWORD=null

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
LOG_STRUCTURED=false
