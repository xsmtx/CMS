{
    "slug": "notifications-discord",
    "name": "Discord notifications",
    "type": "notification-channel",
    "version": "1.0.0",
    "description": "Posts this installation's notifications into a Discord channel.",
    "provider": "InfraCMS",
    "sdk": ">=1.3",
    "platform": "*",
    "namespace": "InfraCMS\\NotificationsDiscord",
    "entrypoint": "DiscordModule",
    "dependencies": [],
    "migrations": false,
    "translations": false,
    "config": [
        {
            "key": "webhook_url",
            "label": "Webhook URL",
            "type": "secret",
            "required": true,
            "hint": "The incoming webhook. Anyone holding it can post to that room, which is why it is a secret."
        },
        {
            "key": "username",
            "label": "Post as",
            "type": "text",
            "required": false,
            "default": "InfraCMS"
        }
    ]
}
