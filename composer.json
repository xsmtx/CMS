{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "infracms/platform",
    "type": "project",
    "description": "InfraCMS - modular, white-label hosting automation platform.",
    "keywords": [
        "hosting",
        "billing",
        "automation",
        "provisioning",
        "laravel"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "brick/money": "^0.15.1",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.50",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "pragmarx/google2fa": "^9.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "@php artisan db:seed --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "stan": "phpstan analyse --memory-limit=1G",
        "rector": "rector process --dry-run",
        "test": [
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=512M vendor/bin/pest"
        ],
        "check": [
            "@lint",
            "@rector",
            "@stan",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "ext-pcntl": "8.4.0",
            "ext-posix": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
