[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
innodb_file_per_table = 1

# Financial and provisioning workloads read their own writes constantly;
# READ-COMMITTED avoids the gap locks that serialise unrelated inserts.
transaction_isolation = READ-COMMITTED

innodb_flush_log_at_trx_commit = 1
max_connections = 200
sql_mode = STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY
